<canvas class="neuron-net pointer-events-none fixed inset-0 -z-10" aria-hidden="true"></canvas>

<script>
  // Faint neuron network fixed behind every page: somata on a jittered grid,
  // each wired to its nearest neighbours with slightly bowed "dendrites". The
  // static web is drawn once to an offscreen canvas; each frame only blits it
  // and draws the signal pulses, which hop node to node and sometimes branch
  // into a cascade.
  const canvas = document.querySelector<HTMLCanvasElement>('.neuron-net');

  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const web = document.createElement('canvas');
    const webCtx = web.getContext('2d')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Node = { x: number; y: number; r: number; edges: number[]; flash: number };
    type Edge = { a: number; b: number; cx: number; cy: number };
    type Pulse = { edge: number; from: number; t: number; speed: number };

    const cellSize = 130;
    const neighbours = 3;
    const maxPulses = 24;

    let nodes: Node[] = [];
    let edges: Edge[] = [];
    let pulses: Pulse[] = [];
    let width = 0;
    let height = 0;
    let dpr = 1;

    // Seeded so the web is the same map on every page of the site (and the
    // same on reload), instead of reshuffling on each navigation.
    function seeded(seed: number) {
      return () => {
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function build() {
      const rand = seeded(0xa1b2c3);
      nodes = [];
      edges = [];
      pulses = [];
      const cols = Math.ceil(width / cellSize) + 1;
      const rows = Math.ceil(height / cellSize) + 1;
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < cols; col++) {
          nodes.push({
            x: (col + 0.15 + rand() * 0.7) * cellSize - cellSize / 2,
            y: (row + 0.15 + rand() * 0.7) * cellSize - cellSize / 2,
            r: rand() > 0.85 ? 2.6 : 1.4,
            edges: [],
            flash: 0,
          });
        }
      }

      const seen = new Set<string>();
      nodes.forEach((node, i) => {
        const nearest = nodes
          .map((other, j) => ({ j, d: Math.hypot(other.x - node.x, other.y - node.y) }))
          .filter(({ j, d }) => j !== i && d < cellSize * 1.6)
          .sort((p, q) => p.d - q.d)
          .slice(0, neighbours);

        nearest.forEach(({ j }) => {
          const key = i < j ? `${i}-${j}` : `${j}-${i}`;
          if (seen.has(key)) return;
          seen.add(key);
          const other = nodes[j];
          const bow = (rand() - 0.5) * 0.4;
          edges.push({
            a: i,
            b: j,
            cx: (node.x + other.x) / 2 - (other.y - node.y) * bow,
            cy: (node.y + other.y) / 2 + (other.x - node.x) * bow,
          });
          node.edges.push(edges.length - 1);
          other.edges.push(edges.length - 1);
        });
      });

      webCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      webCtx.clearRect(0, 0, width, height);
      webCtx.strokeStyle = 'rgba(0, 255, 65, 0.12)';
      webCtx.lineWidth = 1;
      edges.forEach((e) => {
        webCtx.beginPath();
        webCtx.moveTo(nodes[e.a].x, nodes[e.a].y);
        webCtx.quadraticCurveTo(e.cx, e.cy, nodes[e.b].x, nodes[e.b].y);
        webCtx.stroke();
      });
      webCtx.fillStyle = 'rgba(0, 255, 65, 0.3)';
      nodes.forEach((n) => {
        webCtx.beginPath();
        webCtx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        webCtx.fill();
      });
    }

    function drawWeb() {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas!.width, canvas!.height);
      ctx.drawImage(web, 0, 0);
    }

    function resize() {
      // Mobile browsers fire resize as the URL bar shows/hides; only rebuild
      // (which reshuffles the whole web) when the width changes or the
      // viewport grows past what's already drawn.
      const nextWidth = window.innerWidth;
      const nextHeight = window.innerHeight;
      const widthChanged = nextWidth !== width;
      if (!widthChanged && nextHeight <= height) return;

      dpr = window.devicePixelRatio || 1;
      width = nextWidth;
      height = widthChanged ? nextHeight : Math.max(nextHeight, height);
      for (const c of [canvas!, web]) {
        c.width = width * dpr;
        c.height = height * dpr;
      }
      canvas!.style.width = `${width}px`;
      canvas!.style.height = `${height}px`;
      build();
      drawWeb();
    }

    function fire(from: number) {
      const node = nodes[from];
      if (!node || node.edges.length === 0 || pulses.length >= maxPulses) return;
      node.flash = 1;
      const edge = node.edges[Math.floor(Math.random() * node.edges.length)];
      pulses.push({ edge, from, t: 0, speed: 0.6 + Math.random() * 0.5 });
    }

    function pointOn(e: Edge, from: number, t: number) {
      const start = nodes[from];
      const end = nodes[from === e.a ? e.b : e.a];
      const u = 1 - t;
      return {
        x: u * u * start.x + 2 * u * t * e.cx + t * t * end.x,
        y: u * u * start.y + 2 * u * t * e.cy + t * t * end.y,
      };
    }

    let last = 0;
    let nextSpontaneous = 0;

    function tick(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      if (now >= nextSpontaneous) {
        fire(Math.floor(Math.random() * nodes.length));
        nextSpontaneous = now + 500 + Math.random() * 900;
      }

      drawWeb();
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      pulses = pulses.filter((p) => {
        p.t += p.speed * dt;
        const e = edges[p.edge];
        if (p.t >= 1) {
          const to = p.from === e.a ? e.b : e.a;
          nodes[to].flash = 1;
          if (Math.random() < 0.55) fire(to);
          if (Math.random() < 0.15) fire(to);
          return false;
        }
        // short fading tail behind the head of the pulse
        for (let k = 0; k < 5; k++) {
          const pt = pointOn(e, p.from, Math.max(0, p.t - k * 0.035));
          ctx.fillStyle = `rgba(51, 255, 102, ${0.65 * (1 - k / 5)})`;
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 1.6 - k * 0.2, 0, Math.PI * 2);
          ctx.fill();
        }
        return true;
      });

      nodes.forEach((n) => {
        if (n.flash <= 0) return;
        ctx.fillStyle = `rgba(51, 255, 102, ${0.55 * n.flash})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r + 3 * n.flash, 0, Math.PI * 2);
        ctx.fill();
        n.flash = Math.max(0, n.flash - dt * 1.8);
      });

      requestAnimationFrame(tick);
    }

    resize();
    window.addEventListener('resize', resize);

    // Other parts of the page can set the web off at a point on screen (the
    // home atlas does this when a region is hovered): the nearest few cells
    // fire at once and cascade outward from there.
    window.addEventListener('neuron:burst', (event) => {
      if (reduceMotion) return;
      const { x, y } = (event as CustomEvent<{ x: number; y: number }>).detail;
      nodes
        .map((n, i) => ({ i, d: Math.hypot(n.x - x, n.y - y) }))
        .sort((a, b) => a.d - b.d)
        .slice(0, 3)
        .forEach(({ i }) => {
          fire(i);
          fire(i);
        });
    });

    if (!reduceMotion) {
      requestAnimationFrame((now) => {
        last = now;
        tick(now);
      });
    }
  }
</script>
