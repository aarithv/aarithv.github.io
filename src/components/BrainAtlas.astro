---
import { getSections } from '../data/content';

const sections = await getSections();
---

<section class="brain-atlas relative" aria-labelledby="brain-title" data-brain>
  <h2 id="brain-title" class="sr-only">Atlas of one brain</h2>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="brain-stage relative">
      <canvas class="brain-canvas block h-full w-full" aria-hidden="true"></canvas>
      <svg class="brain-leaders pointer-events-none absolute inset-0 h-full w-full overflow-visible" aria-hidden="true"></svg>
      {/* The callout labels are the links: hover lights the structure, focus also turns the brain to show it. */}
      <nav class="brain-tags pointer-events-none absolute inset-0" aria-label="Brain regions">
        {sections.map((r) => (
          <a href={r.href} class="brain-tag font-terminal" data-region={r.id} aria-label={`${r.label} — ${r.structure}`}>
            {r.label}
          </a>
        ))}
      </nav>
      <p class="brain-loading pointer-events-none absolute inset-0 flex items-center justify-center text-xs text-phosphor-dim">Loading brain…</p>
    </div>

    <div class="flex flex-col gap-2 pb-8 pt-2 text-xs sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
      <p class="shrink-0 text-phosphor-dim">
        <span class="hint-mouse">Drag to rotate · click a region to open it</span>
        <span class="hint-touch">Swipe sideways to rotate · tap a region</span>
      </p>
      <p class="max-w-[72ch] leading-relaxed text-phosphor-600 sm:text-right">
        Anatomy: ICBM 2009 MNI152 template © 1993–2009 Louis Collins, McConnell Brain Imaging Centre, McGill
        University. Regions: Harvard-Oxford atlases (Harvard Center for Morphometric Analysis, via FSL).
      </p>
    </div>
  </div>
</section>

<style>
  .brain-stage {
    height: min(82svh, 52rem);
    min-height: 22rem;
  }
  @media (max-width: 639px) {
    .brain-stage {
      height: 52svh;
      margin-inline: -1.25rem;
    }
  }
  .brain-canvas {
    /* Opaque-black canvas with bloom, screened onto the page so the black drops
       out; the mask feathers the edges so the bloom floor never reads as a box. */
    mix-blend-mode: screen;
    mask-image: radial-gradient(closest-side, black 80%, transparent);
    cursor: grab;
    touch-action: pan-y;
  }
  .brain-canvas.is-dragging {
    cursor: grabbing;
  }
  .brain-canvas.is-pointing {
    cursor: pointer;
  }
  .brain-loading {
    transition: opacity 400ms ease-out;
  }
  [data-brain].is-ready .brain-loading {
    opacity: 0;
  }

  .hint-touch {
    display: none;
  }
  @media (hover: none) {
    .hint-mouse {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }

  .brain-tag {
    position: absolute;
    left: 0;
    top: 0;
    /* Extra padding widens the hit area without moving the text. */
    padding: 0.35rem 0.3rem;
    margin: -0.35rem -0.3rem;
    pointer-events: auto;
    font-size: 1.25rem;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-phosphor-400);
    opacity: 0;
    transition:
      opacity 200ms ease-out,
      color 200ms ease-out;
    will-change: transform;
  }
  [data-brain].is-ready .brain-tag {
    opacity: 0.75;
  }
  .brain-tag:focus-visible {
    outline-offset: 0;
  }
  [data-brain].is-ready .brain-tag.is-active {
    opacity: 1;
    color: var(--color-phosphor-300);
  }
  :global(.brain-leader) {
    fill: none;
    stroke: var(--color-phosphor-500);
    stroke-width: 1;
    opacity: 0.45;
  }
  :global(.brain-leader.is-active) {
    stroke: var(--color-phosphor-300);
    opacity: 1;
  }
  :global(.brain-anchor) {
    fill: var(--color-phosphor-400);
  }

</style>

<script>
  // A navigable brain built from real anatomy (MNI152 template surface plus
  // Harvard-Oxford regions; see brain-pipeline/make_brain.py). The cortex is a
  // translucent rim-lit shell so the deep structures (thalamus, striatum,
  // hippocampus) show where they really sit inside it. Drag to rotate; hover
  // a region or its label to light it; click (or tap twice on touch) to open its page.
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';
  import { regions } from '../data/regions';
  import { hologramMaterial } from '../lib/brainShader';

  const root = document.querySelector<HTMLElement>('[data-brain]');
  const stage = root?.querySelector<HTMLElement>('.brain-stage');
  const canvas = root?.querySelector<HTMLCanvasElement>('.brain-canvas');
  const leaders = root?.querySelector<SVGSVGElement>('.brain-leaders');

  if (root && stage && canvas && leaders) {
    const NS = 'http://www.w3.org/2000/svg';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(hover: none)').matches;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 50);
    camera.position.set(0, 0, 4.8);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setClearColor(0x000000, 1);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    composer.addPass(new UnrealBloomPass(new THREE.Vector2(1, 1), 0.35, 0.4, 0.5));
    composer.addPass(new OutputPass());



    const brain = new THREE.Group();
    scene.add(brain);

    type Picked = {
      id: string;
      mesh: THREE.Mesh;
      material: THREE.ShaderMaterial;
      lit: number;
      // One anchor per hemisphere; the label follows whichever faces the viewer.
      anchors: THREE.Vector3[];
      tag: HTMLElement;
      line: SVGPathElement;
      side: number;
      dot: SVGCircleElement;
    };
    const picked: Picked[] = [];
    const materials: THREE.ShaderMaterial[] = [];
    let ready = false;
    let brainRadius = 1;

    // Orientation: yaw 0 is a left-lateral view (the left hemisphere faces
    // the camera, front of the brain to the left of the screen).
    const BASE_YAW = Math.PI / 2;
    const rot = { yaw: -0.5, pitch: 0.12 };
    const target = { yaw: rot.yaw, pitch: rot.pitch };
    let idleSince = performance.now();
    let hovered: string | null = null;
    let selected: string | null = null;

    function hemisphereAnchors(geometry: THREE.BufferGeometry) {
      const pos = geometry.attributes.position;
      const sums = [new THREE.Vector3(), new THREE.Vector3()];
      const counts = [0, 0];
      const v = new THREE.Vector3();
      for (let i = 0; i < pos.count; i++) {
        v.fromBufferAttribute(pos, i);
        const side = v.x < 0 ? 0 : 1;
        sums[side].add(v);
        counts[side]++;
      }
      return sums.flatMap((sum, i) => (counts[i] > 0 ? [sum.divideScalar(counts[i])] : []));
    }

    new GLTFLoader().load(
      '/brain/brain.glb',
      (gltf) => {
        const box = new THREE.Box3();
        const meshes: THREE.Mesh[] = [];
        gltf.scene.traverse((o) => {
          if ((o as THREE.Mesh).isMesh) meshes.push(o as THREE.Mesh);
        });
        const cortex = meshes.find((m) => m.name === 'cortex' || m.parent?.name === 'cortex');
        if (cortex) box.setFromObject(cortex);
        const center = box.getCenter(new THREE.Vector3());
        brainRadius = box.getSize(new THREE.Vector3()).length() / 2;

        meshes.forEach((mesh) => {
          const name = mesh.name || mesh.parent?.name || '';
          mesh.geometry.translate(-center.x, -center.y, -center.z);
          mesh.geometry.computeVertexNormals();
          const isCortex = name === 'cortex';
          const material = isCortex ? hologramMaterial(0.0, 0.075) : hologramMaterial(0.05, 0.3);
          mesh.material = material;
          mesh.renderOrder = isCortex ? 0 : 1;
          materials.push(material);
          brain.add(mesh);

          const region = regions.find((r) => r.id === name);
          if (!region) return;
          const tag = root!.querySelector<HTMLElement>(`.brain-tag[data-region="${region.id}"]`)!;
          const line = document.createElementNS(NS, 'path');
          line.setAttribute('class', 'brain-leader');
          const dot = document.createElementNS(NS, 'circle');
          dot.setAttribute('r', '2.2');
          dot.setAttribute('class', 'brain-anchor');
          leaders!.append(line, dot);
          const side = region.map.x < 0 ? -1 : 1;
          picked.push({ id: region.id, mesh, material, lit: 0, anchors: hemisphereAnchors(mesh.geometry), tag, line, dot, side });
        });

        ready = true;
        root!.classList.add('is-ready');
        resize();
        requestRender();
      },
      undefined,
      (err) => console.error('Failed to load brain model:', err)
    );

    // ---- Sizing & render scheduling ----
    let width = 0;
    let height = 0;
    function resize() {
      width = stage!.clientWidth;
      height = stage!.clientHeight;
      if (!width || !height) return;
      renderer.setSize(width, height, false);
      composer.setSize(width, height);
      camera.aspect = width / height;
      // Keep the whole brain in frame on narrow (portrait) screens.
      // Wide stages get the camera closer so the brain fills the width it now has.
      camera.position.z = camera.aspect < 1 ? (4.8 * 0.88) / Math.max(camera.aspect, 0.6) : camera.aspect > 1.3 ? 3.9 : 4.8;
      camera.updateProjectionMatrix();
      leaders!.setAttribute('viewBox', `0 0 ${width} ${height}`);
      requestRender();
    }
    new ResizeObserver(resize).observe(stage);

    let onScreen = true;
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) requestRender();
    }).observe(stage);

    let frame = 0;
    function requestRender() {
      if (!frame) frame = requestAnimationFrame(tick);
    }

    // ---- Labels ----
    // Atlas callouts: each label sits in a column beside the brain (left or
    // right of the brain's on-screen centre, by where its structure projects),
    // labels in a column are spaced so they never overlap, and an elbow leader
    // runs from the structure's facing hemisphere out to its label.
    const projected = new THREE.Vector3();
    const worldAnchor = new THREE.Vector3();
    const centerScreen = new THREE.Vector3();
    const GAP = 30;
    const EDGE = 8;
    function placeLabels() {
      centerScreen.set(0, 0, 0).applyMatrix4(brain.matrixWorld).project(camera);
      const cx = (centerScreen.x * 0.5 + 0.5) * width;
      const cy = (-centerScreen.y * 0.5 + 0.5) * height;
      const halfFov = THREE.MathUtils.degToRad(camera.fov / 2);
      const radiusPx = (brainRadius / (camera.position.z * Math.tan(halfFov))) * (height / 2) * 0.78;

      const placed = picked.map((p) => {
        let best = p.anchors[0];
        let bestDist = Infinity;
        p.anchors.forEach((a) => {
          worldAnchor.copy(a).applyMatrix4(brain.matrixWorld);
          const d = worldAnchor.distanceTo(camera.position);
          if (d < bestDist) {
            bestDist = d;
            best = a;
          }
        });
        projected.copy(best).applyMatrix4(brain.matrixWorld).project(camera);
        const ax = (projected.x * 0.5 + 0.5) * width;
        const ay = (-projected.y * 0.5 + 0.5) * height;
        // Structures well off-centre take their own side; ones near the
        // middle keep their home side so labels don't flip back and forth.
        const side = Math.abs(ax - cx) > radiusPx * 0.35 ? Math.sign(ax - cx) : p.side;
        return { p, ax, ay, side, ly: ay, tw: p.tag.offsetWidth, th: p.tag.offsetHeight };
      });

      [-1, 1].forEach((side) => {
        const column = placed.filter((l) => l.side === side).sort((a, b) => a.ay - b.ay);
        // Push down to clear the label above, then pull back up from the bottom edge.
        for (let i = 0; i < column.length; i++) {
          const min = i === 0 ? EDGE + column[i].th / 2 : column[i - 1].ly + GAP;
          column[i].ly = Math.max(column[i].ay, min);
        }
        for (let i = column.length - 1; i >= 0; i--) {
          const max = i === column.length - 1 ? height - EDGE - column[i].th / 2 - 28 : column[i + 1].ly - GAP;
          column[i].ly = Math.min(column[i].ly, max);
        }
      });

      placed.forEach(({ p, ax, ay, side, ly, tw, th }) => {
        const columnX = cx + side * (radiusPx + 18);
        const tx = THREE.MathUtils.clamp(side > 0 ? columnX + 6 : columnX - tw - 6, EDGE, width - tw - EDGE);
        const endX = side > 0 ? tx - 6 : tx + tw + 6;
        const elbowX = ax + (endX - ax) * 0.55;
        p.line.setAttribute('d', `M${ax} ${ay} L${elbowX} ${ly} L${endX} ${ly}`);
        p.dot.setAttribute('cx', String(ax));
        p.dot.setAttribute('cy', String(ay));
        p.tag.style.transform = `translate(${tx}px, ${ly - th / 2}px)`;
        const active = p.id === hovered || p.id === selected;
        p.tag.classList.toggle('is-active', active);
        p.line.classList.toggle('is-active', active);
      });
    }

    // ---- Main loop ----
    const start = performance.now();
    function tick(now: number) {
      frame = 0;
      if (!ready || !onScreen || !width) return;
      const t = (now - start) / 1000;
      materials.forEach((m) => (m.uniforms.uTime.value = t));

      const idle = !dragging && !hovered && !selected && now - idleSince > 2500;
      if (idle && !reduceMotion) target.yaw += 0.0025;
      rot.yaw += (target.yaw - rot.yaw) * 0.08;
      rot.pitch += (target.pitch - rot.pitch) * 0.08;
      brain.rotation.set(rot.pitch, BASE_YAW + rot.yaw, 0, 'XYZ');
      brain.updateMatrixWorld();

      let animating = Math.abs(target.yaw - rot.yaw) > 0.0005 || Math.abs(target.pitch - rot.pitch) > 0.0005;
      picked.forEach((p) => {
        const goal = p.id === hovered || p.id === selected ? 1 : 0;
        p.lit += (goal - p.lit) * 0.15;
        if (Math.abs(goal - p.lit) > 0.002) animating = true;
        p.material.uniforms.uLit.value = p.lit;
      });

      composer.render();
      placeLabels();
      // Keep looping while anything moves; the scanline shimmer and idle spin
      // keep it alive unless reduced motion is on.
      if (!reduceMotion || animating || dragging) requestRender();
    }

    // ---- Interaction ----
    const raycaster = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    function pick(clientX: number, clientY: number) {
      const rect = canvas!.getBoundingClientRect();
      ndc.set(((clientX - rect.left) / rect.width) * 2 - 1, -((clientY - rect.top) / rect.height) * 2 + 1);
      raycaster.setFromCamera(ndc, camera);
      const hit = raycaster.intersectObjects(picked.map((p) => p.mesh), false)[0];
      return hit ? picked.find((p) => p.mesh === hit.object)?.id ?? null : null;
    }

    function setActive(id: string | null) {
      hovered = id;
      canvas!.classList.toggle('is-pointing', !!id);
      idleSince = performance.now();
      requestRender();
    }

    let dragging = false;
    let moved = 0;
    let lastX = 0;
    let lastY = 0;
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      moved = 0;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas!.setPointerCapture(e.pointerId);
      canvas!.classList.add('is-dragging');
    });
    canvas.addEventListener('pointermove', (e) => {
      if (dragging) {
        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        lastX = e.clientX;
        lastY = e.clientY;
        moved += Math.abs(dx) + Math.abs(dy);
        target.yaw += dx * 0.008;
        // Touch only turns the brain sideways, so vertical swipes still scroll.
        if (e.pointerType === 'mouse') target.pitch = THREE.MathUtils.clamp(target.pitch + dy * 0.006, -0.9, 0.9);
        idleSince = performance.now();
        requestRender();
      } else if (e.pointerType === 'mouse' && ready) {
        const id = pick(e.clientX, e.clientY);
        if (id !== hovered) setActive(id);
      }
    });
    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      canvas!.classList.remove('is-dragging');
      if (moved > 6 || !ready) return;
      // A click, not a drag.
      const id = pick(e.clientX, e.clientY);
      const region = regions.find((r) => r.id === id);
      if (!region) {
        selected = null;
        setActive(null);
        return;
      }
      if (e.pointerType === 'mouse' || selected === id) {
        window.location.href = region.href;
      } else {
        // First tap on touch selects and names the region; a second tap opens it.
        selected = id;
        setActive(id);
      }
    };
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', () => {
      dragging = false;
      canvas!.classList.remove('is-dragging');
    });
    canvas.addEventListener('pointerleave', () => {
      if (!dragging && !selected) setActive(null);
    });

    // The callout labels are links too. Hovering one lights its structure;
    // keyboard focus also turns the brain to the view that shows it best (not
    // on hover, where turning would slide the label out from under the pointer).
    root.querySelectorAll<HTMLAnchorElement>('.brain-tag').forEach((link) => {
      const region = regions.find((r) => r.id === link.dataset.region)!;
      link.addEventListener('pointerenter', () => setActive(region.id));
      link.addEventListener('pointerleave', () => setActive(null));
      link.addEventListener('focus', () => {
        // Pick the equivalent yaw nearest the current one so it never spins the long way.
        const turns = Math.round((target.yaw - region.view.yaw) / (Math.PI * 2));
        target.yaw = region.view.yaw + turns * Math.PI * 2;
        target.pitch = region.view.pitch;
        setActive(region.id);
      });
      link.addEventListener('blur', () => setActive(null));
    });

    if (coarse) canvas.style.cursor = 'auto';
  }
</script>
