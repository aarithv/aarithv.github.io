---
import BrainMini from './BrainMini.astro';
import RuneRain from './RuneRain.astro';
import { getSectionFor, plateFor } from '../data/content';

interface Props {
  title: string;
}

const { title } = Astro.props;
const region = await getSectionFor(Astro.url.pathname);
---

<div class="page-header-band relative overflow-hidden">
  <RuneRain intensity={0.13} class="header-rain" />
  <header class="relative mx-auto w-full max-w-6xl px-5 pb-10 pt-12 sm:px-8 sm:pb-14 sm:pt-16">
    <div class="grid items-end gap-8 md:grid-cols-[minmax(0,1fr)_18rem] lg:grid-cols-[minmax(0,1fr)_21rem]">
      <div class="min-w-0">
        <h1 class="page-title font-terminal relative text-[clamp(3rem,9vw,5.5rem)] leading-[0.9] text-phosphor-400 text-glow" data-decode>
          {title}
        </h1>
        {region && (
          <p class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
            <span class="text-phosphor-500">{region.structure}</span>
            <span class="text-phosphor-dim">— {region.role}</span>
          </p>
        )}
        <div class="prose-body mt-5 max-w-prose text-sm leading-relaxed text-phosphor-dim">
          <slot />
        </div>
      </div>
      {region && <BrainMini region={region.id} class="w-full max-w-[21rem] md:justify-self-end" />}
    </div>
    <div class="mt-10 flex items-start gap-4">
      <div class="tick-rule flex-1" aria-hidden="true"></div>
      {region && (
        <p class="-mt-2 shrink-0 text-xs uppercase tracking-[0.1em] tabular-nums text-phosphor-dim">
          {plateFor(region)}<span class="hidden sm:inline"> · {region.structure}</span>
        </p>
      )}
    </div>
  </header>
</div>

<style>
  /* The rain fills the header band and dies out before the content starts. */
  .header-rain {
    mask-image: linear-gradient(to bottom, black 15%, transparent 92%);
  }
  :global(.decode-layer) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
</style>

<script>
  // The title decodes out of the rune rain: each letter cycles through runes
  // and settles left to right. The real text stays in the DOM underneath
  // (transparent while decoding) so layout never shifts and assistive tech
  // reads the title straight away.
  const RUNES = Array.from({ length: 0x16f9 - 0x16a0 }, (_, i) => String.fromCodePoint(0x16a0 + i));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-decode]').forEach((title) => {
    if (reduceMotion) return;
    const text = title.textContent!.trim();
    const layer = document.createElement('span');
    layer.className = 'decode-layer';
    layer.setAttribute('aria-hidden', 'true');
    layer.style.color = getComputedStyle(title).color;
    title.append(layer);
    title.style.color = 'transparent';

    const duration = 900;
    const start = performance.now();
    function step(now: number) {
      const t = (now - start) / duration;
      let out = '';
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        const settleAt = (i / Math.max(1, text.length - 1)) * 0.75 + 0.2;
        out += ch === ' ' || t >= settleAt ? ch : RUNES[Math.floor(Math.random() * RUNES.length)];
      }
      layer.textContent = out;
      if (t < 1) {
        requestAnimationFrame(step);
      } else {
        layer.remove();
        title.style.color = '';
      }
    }
    requestAnimationFrame(step);
  });
</script>
