---
import { getSite } from '../data/content';

const site = await getSite();
const links = site.links ?? [];
---

<footer class="site-footer mt-auto border-t border-phosphor-600/30">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-[1fr_auto] sm:items-end sm:px-8">
    <div>
      <p class="font-terminal text-3xl leading-none text-phosphor-400">{site.tagline}</p>
      <p class="mt-3 text-xs text-phosphor-dim">&copy; {new Date().getFullYear()} {site.name}{site.location && ` · ${site.location}`}</p>
    </div>
    <ul class="flex flex-wrap gap-3">
      {links.map((link) => (
        <li>
          <a href={link.href} class="btn" {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
            {link.label}
            <svg viewBox="0 0 12 12" class="h-3 w-3" aria-hidden="true">
              <path d="M3 9L9 3M4.5 3H9v4.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: color-mix(in srgb, var(--color-crt-void) 82%, transparent);
  }
</style>
