---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AsciiPanel from '../components/AsciiPanel.astro';
import { getBio, getPage } from '../data/content';

const page = await getPage('about');
const Bio = await getBio();
const image = (file: string) => `/images/about/${encodeURIComponent(file)}`;
const photos = (page.snapshots ?? []).map((p) => ({ src: image(p.file), alt: p.caption ?? p.alt ?? '' }));
const readout = page.readout ?? [];
---

<BaseLayout title={page.title} description={page.description} image={page.shareImage}>
  <PageHeader title={page.title ?? 'About'}>{page.hasBody && <page.Content />}</PageHeader>

  <div class="mx-auto grid max-w-6xl gap-12 px-5 pb-24 sm:px-8 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-14">
    <figure class="self-start">
      <div class="atlas-frame headshot relative p-2">
        {page.headshot && <img src={image(page.headshot.file)} alt={page.headshot.alt ?? ''} class="aspect-[4/5] w-full object-cover" />}
      </div>
      <figcaption class="mt-3 flex justify-between text-xs text-phosphor-dim">
        <span>Fig. 1</span>
        <span>{page.headshot?.alt}</span>
      </figcaption>
    </figure>

    <div class="min-w-0">
      <div class="prose-body max-w-[64ch] text-[0.94rem] leading-[1.75]">
        <Bio />
      </div>

      <dl class="mt-12 border-t border-phosphor-600/30 text-sm">
        {readout.map((row) => (
          <div class="grid gap-1 border-b border-phosphor-600/30 py-3.5 sm:grid-cols-[7.5rem_1fr] sm:gap-6">
            <dt class="text-xs uppercase tracking-[0.08em] text-phosphor-dim sm:pt-0.5">{row.key}</dt>
            <dd class="leading-relaxed">{row.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  {photos.length > 0 && (<div class="mx-auto max-w-6xl px-5 pb-28 sm:px-8">
    <AsciiPanel title="SNAPSHOTS" meta={`${photos.length} figures`}>
      <div class="grid gap-6 sm:grid-cols-3">
        {photos.map((photo, i) => (
          <figure>
            <div class="snapshot overflow-hidden border border-phosphor-600/40">
              <img src={photo.src} alt={photo.alt} loading="lazy" class="aspect-square w-full object-cover" />
            </div>
            <figcaption class="mt-2.5 text-xs leading-snug text-phosphor-dim">
              <span class="text-phosphor-500">Fig. {i + 2}</span> — {photo.alt}
            </figcaption>
          </figure>
        ))}
      </div>
    </AsciiPanel>
  </div>)}
</BaseLayout>

<script>
  // Same as the photo grid: a figure resolves into colour while it sits in
  // the middle band of the screen, so touch screens get the reveal too.
  const figures = document.querySelectorAll('figure');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-attended', e.isIntersecting)),
      { rootMargin: '-38% 0px -38% 0px' }
    );
    figures.forEach((f) => observer.observe(f));
  } else {
    figures.forEach((f) => f.classList.add('is-attended'));
  }
</script>

<style>
  /* Phosphor monochrome until looked at, like every photo on the site. */
  .headshot img,
  .snapshot img {
    filter: grayscale(1) sepia(1) hue-rotate(62deg) saturate(2.6) brightness(0.8);
    transition:
      filter 450ms ease-out,
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  figure:hover .headshot img,
  figure:hover .snapshot img,
  figure.is-attended .headshot img,
  figure.is-attended .snapshot img {
    filter: none;
  }
  figure:hover .snapshot img {
    transform: scale(1.02);
  }
</style>
