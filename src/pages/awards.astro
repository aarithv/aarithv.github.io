---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { getPage } from '../data/content';

const page = await getPage('awards');

const entries = (await getCollection('awards')).sort((a, b) => b.data.year - a.data.year);
const years = [...new Set(entries.map((e) => e.data.year))];
const byYear = years.map((year) => ({ year, items: entries.filter((e) => e.data.year === year) }));

// Raster bins run continuously from the first year to the latest, so quiet
// years show as silence rather than disappearing.
const first = Math.min(...years);
const last = Math.max(...years);
const raster = Array.from({ length: last - first + 1 }, (_, i) => {
  const year = first + i;
  return { year, items: entries.filter((e) => e.data.year === year) };
});
---

<BaseLayout title={page.title} description={page.description} image={page.shareImage}>
  <PageHeader title={page.title ?? 'Awards'}>{page.hasBody && <page.Content />}</PageHeader>

  <div class="mx-auto max-w-6xl px-5 pb-28 sm:px-8">
    <figure class="raster atlas-frame mb-14 px-4 pb-4 pt-3 sm:px-6 sm:pb-5" aria-labelledby="raster-title">
      <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <span id="raster-title" class="font-terminal text-[1.25rem] leading-none text-phosphor-400">Reward signal</span>
        <span class="raster-readout text-xs tabular-nums text-phosphor-dim" aria-live="polite">
          Each spike is one honor, binned by year. Hover a spike to read it.
        </span>
      </figcaption>
      <div class="raster-plot mt-5" style={`--bins: ${raster.length}`}>
        {raster.map(({ year, items }) => (
          <div class="raster-bin">
            <div class="raster-spikes">
              {items.map((entry, i) => (
                <a
                  href={`#${entry.id}`}
                  class="spike"
                  style={`--d: ${i}`}
                  data-label={`${year} · ${entry.data.name} — ${entry.data.body}`}
                  aria-label={`${year}: ${entry.data.name}, ${entry.data.body}`}
                ></a>
              ))}
            </div>
            <div class="raster-axis flex items-baseline justify-between gap-2 text-xs tabular-nums">
              <span class:list={[items.length ? 'text-phosphor-400' : 'text-phosphor-600']}>{year}</span>
              <span class="text-phosphor-dim">{items.length || '—'}</span>
            </div>
          </div>
        ))}
      </div>
    </figure>

    {byYear.map(({ year, items }) => (
      <section class="year-block grid gap-x-10 border-t border-phosphor-600/30 py-10 md:grid-cols-[10rem_minmax(0,1fr)]">
        <h2 class="mb-6 flex items-baseline gap-3 md:mb-0 md:block">
          <span class="font-terminal block text-[clamp(3.5rem,8vw,4.5rem)] leading-[0.8] tabular-nums text-phosphor-400">{year}</span>
          <span class="text-xs text-phosphor-dim md:mt-3 md:block">
            {items.length} {items.length === 1 ? 'honor' : 'honors'}
          </span>
        </h2>
        <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {items.map((entry) => (
            <li class="award" id={entry.id}>
              <h3 class="font-terminal text-[1.5rem] leading-[1.05] text-phosphor-400">{entry.data.name}</h3>
              <p class="mt-1.5 text-xs text-phosphor-dim">{entry.data.body}</p>
              <p class="mt-3 text-sm leading-relaxed">{entry.data.context}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  // Hovering or focusing a spike names its honor in the readout.
  const readout = document.querySelector<HTMLElement>('.raster-readout');
  const resting = readout?.textContent ?? '';
  document.querySelectorAll<HTMLAnchorElement>('.spike').forEach((spike) => {
    const show = () => readout && (readout.textContent = spike.dataset.label ?? '');
    const hide = () => readout && (readout.textContent = resting);
    spike.addEventListener('pointerenter', show);
    spike.addEventListener('focus', show);
    spike.addEventListener('pointerleave', hide);
    spike.addEventListener('blur', hide);
  });
</script>

<style>
  .raster-plot {
    display: grid;
    grid-template-columns: repeat(var(--bins), minmax(0, 1fr));
  }
  .raster-bin {
    border-left: 1px solid color-mix(in srgb, var(--color-phosphor-600) 30%, transparent);
    padding-inline: 0.5rem;
  }
  .raster-bin:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .raster-spikes {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 5.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-phosphor-500) 60%, transparent);
  }
  .raster-axis {
    padding-top: 0.5rem;
  }
  .spike {
    position: relative;
    flex: 0 0 auto;
    width: 2px;
    height: 100%;
    background: var(--color-phosphor-500);
    transform-origin: bottom;
    transition:
      background-color 140ms ease-out,
      box-shadow 140ms ease-out;
  }
  /* Wider invisible hit area around each 2px spike. */
  .spike::before {
    content: '';
    position: absolute;
    inset: 0 -5px;
  }
  .spike:hover,
  .spike:focus-visible {
    background: var(--color-phosphor-300);
    outline: none;
  }
  .spike:focus-visible::after {
    content: '';
    position: absolute;
    inset: -4px -5px;
    border: 1px solid var(--color-phosphor-400);
  }
  @media (prefers-reduced-motion: no-preference) {
    .spike {
      animation: spike-fire 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(200ms + var(--d) * 70ms);
    }
  }
  @keyframes spike-fire {
    from {
      transform: scaleY(0);
    }
  }
  @media (max-width: 639px) {
    .raster-bin {
      padding-inline: 0.3rem;
    }
    .raster-spikes {
      gap: 3px;
    }
  }

  .award {
    scroll-margin-top: 5rem;
    padding-left: 1.1rem;
    background: linear-gradient(var(--color-phosphor-500), var(--color-phosphor-500)) 0 0.55rem / 7px 1px no-repeat;
  }
</style>
