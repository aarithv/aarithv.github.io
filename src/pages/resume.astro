---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AsciiPanel from '../components/AsciiPanel.astro';
import { getDocuments, getPage } from '../data/content';

const page = await getPage('resume');
const documents = await getDocuments();
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeader title={page.title ?? 'Resume'}>{page.hasBody && <page.Content />}</PageHeader>

  <div class="mx-auto flex max-w-6xl flex-col gap-14 px-5 pb-28 sm:px-8">
    {documents.map((doc) => (
      <AsciiPanel title={doc.label.toUpperCase()} meta="PDF">
        <div class="flex flex-wrap items-center gap-3">
          <a href={doc.href} download class="btn btn-solid">
            <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M8 2v8M4.5 6.5L8 10l3.5-3.5M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
            </svg>
            Download
          </a>
          <a href={doc.href} target="_blank" rel="noopener" class="btn">
            Open in new tab
            <svg viewBox="0 0 12 12" class="h-3 w-3" aria-hidden="true">
              <path d="M3 9L9 3M4.5 3H9v4.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" />
            </svg>
          </a>
        </div>
        {/* Phone browsers mostly can't draw a PDF inside an iframe (Android
            shows a blank box), so the inline viewer is desktop-only. */}
        <div class="viewer relative mt-5 hidden border border-phosphor-600/40 bg-crt-black md:block">
          {/* Sits under the iframe; only seen if the browser's PDF viewer draws nothing. */}
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 text-center">
            <p class="font-terminal text-2xl text-phosphor-400">{doc.label}</p>
            <a href={doc.href} target="_blank" rel="noopener" class="link text-sm">Open the PDF</a>
          </div>
          <iframe src={doc.href} title={doc.label} loading="lazy" class="relative h-[78vh] w-full"></iframe>
        </div>
      </AsciiPanel>
    ))}
  </div>
</BaseLayout>
