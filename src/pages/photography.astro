---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { getPage, getPhotos } from '../data/content';

const page = await getPage('photography');
const photos = await getPhotos();
---

<BaseLayout title={page.title} description={page.description} image={page.shareImage}>
  <PageHeader title={page.title ?? 'Photography'}>{page.hasBody && <page.Content />}</PageHeader>

  <div class="mx-auto max-w-6xl px-5 pb-28 sm:px-8">
    <PhotoGrid photos={photos} />
  </div>

  <div
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
    class="lightbox fixed inset-0 z-50 hidden flex-col bg-crt-void/[0.97]"
  >
    <div class="flex h-14 shrink-0 items-center justify-between gap-4 border-b border-phosphor-600/30 bg-crt-void px-4 sm:px-8">
      <p class="text-xs tabular-nums text-phosphor-dim">
        <span id="lightbox-counter" class="text-phosphor-400"></span>
        <span id="lightbox-caption" class="ml-3"></span>
      </p>
      <button id="lightbox-close" type="button" aria-label="Close" class="lb-btn">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"></path>
        </svg>
      </button>
    </div>
    <div class="relative flex min-h-0 flex-1 items-center justify-center p-4 sm:p-10">
      <img id="lightbox-img" src="" alt="" class="atlas-frame max-h-full max-w-full object-contain p-1.5" />
    </div>
    <div class="flex h-16 shrink-0 items-center justify-center gap-3 border-t border-phosphor-600/30 bg-crt-void">
      <button id="lightbox-prev" type="button" aria-label="Previous photo" class="lb-btn">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12 4L6 10L12 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"></path>
        </svg>
      </button>
      <button id="lightbox-next" type="button" aria-label="Next photo" class="lb-btn">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M8 4L14 10L8 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"></path>
        </svg>
      </button>
    </div>
    <p id="lightbox-status" class="sr-only" role="status" aria-live="polite"></p>
  </div>
</BaseLayout>

<style>
  .lb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid color-mix(in srgb, var(--color-phosphor-600) 60%, transparent);
    color: var(--color-phosphor-400);
    transition:
      border-color 160ms ease-out,
      background-color 160ms ease-out;
  }
  .lb-btn:hover {
    border-color: var(--color-phosphor-400);
    background-color: color-mix(in srgb, var(--color-phosphor-500) 12%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox.flex #lightbox-img {
      animation: lb-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }
</style>

<script>
  const triggers = document.querySelectorAll('[data-lightbox-index]');
  const overlay = document.querySelector('#lightbox');
  const overlayImg = document.querySelector('#lightbox-img');
  const status = document.querySelector('#lightbox-status');
  const counter = document.querySelector('#lightbox-counter');
  const caption = document.querySelector('#lightbox-caption');
  const closeBtn = document.querySelector('#lightbox-close');
  const prevBtn = document.querySelector('#lightbox-prev');
  const nextBtn = document.querySelector('#lightbox-next');
  const focusable = [prevBtn, closeBtn, nextBtn].filter(Boolean);

  const photos = Array.from(triggers).map((el) => ({
    src: el.getAttribute('data-full-src') || '',
    alt: el.getAttribute('data-alt') || '',
  }));

  let currentIndex = 0;
  let lastTrigger: Element | null = null;

  function openAt(index: number) {
    if (photos.length === 0 || !overlay || !overlayImg) return;
    currentIndex = (index + photos.length) % photos.length;
    const photo = photos[currentIndex];
    (overlayImg as HTMLImageElement).src = photo.src;
    (overlayImg as HTMLImageElement).alt = photo.alt;
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    if (status) {
      status.textContent = `Photo ${currentIndex + 1} of ${photos.length}: ${photo.alt}`;
    }
    const pad = (n: number) => String(n).padStart(2, '0');
    if (counter) counter.textContent = `${pad(currentIndex + 1)} / ${pad(photos.length)}`;
    if (caption) caption.textContent = photo.alt;
    if (closeBtn) (closeBtn as HTMLElement).focus();
  }

  function closeLightbox() {
    if (!overlay) return;
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
    if (lastTrigger) (lastTrigger as HTMLElement).focus();
  }

  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', () => {
      lastTrigger = trigger;
      openAt(index);
    });
  });

  if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
  if (overlay) {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeLightbox();
    });
  }
  if (prevBtn) prevBtn.addEventListener('click', () => openAt(currentIndex - 1));
  if (nextBtn) nextBtn.addEventListener('click', () => openAt(currentIndex + 1));

  document.addEventListener('keydown', (e) => {
    if (!overlay || overlay.classList.contains('hidden')) return;
    if (e.key === 'Escape') {
      closeLightbox();
      return;
    }
    if (e.key === 'ArrowLeft') openAt(currentIndex - 1);
    if (e.key === 'ArrowRight') openAt(currentIndex + 1);

    if (e.key === 'Tab' && focusable.length > 0) {
      const currentPos = focusable.indexOf(document.activeElement);
      e.preventDefault();
      const step = e.shiftKey ? -1 : 1;
      const nextPos = (currentPos + step + focusable.length) % focusable.length;
      (focusable[nextPos] as HTMLElement).focus();
    }
  });
</script>
