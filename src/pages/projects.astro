---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AsciiPanel from '../components/AsciiPanel.astro';
import { getPage } from '../data/content';

const page = await getPage('projects');
const tools = page.tools ?? [];
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeader title={page.title ?? 'Projects'}>{page.hasBody && <page.Content />}</PageHeader>

  <div class="mx-auto flex max-w-6xl flex-col gap-14 px-5 pb-28 sm:px-8">
    {tools.length > 0 && (
      <AsciiPanel title="TOOLS" meta={`${tools.length} ${tools.length === 1 ? 'tool' : 'tools'}`}>
        {tools.map((tool) => (
          <a href={tool.href} class="tool-row group -mx-4 grid gap-3 px-4 py-4 sm:-mx-6 sm:grid-cols-[14rem_minmax(0,1fr)_auto] sm:items-center sm:gap-8 sm:px-6">
            <span class="font-terminal text-[1.9rem] leading-[1.02] text-phosphor-400">{tool.name}</span>
            <span class="max-w-[62ch] text-sm leading-relaxed">{tool.summary}</span>
            <svg viewBox="0 0 24 24" class="tool-arrow h-4 w-4 text-phosphor-400" aria-hidden="true">
              <path d="M4 12h14M12 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
            </svg>
          </a>
        ))}
      </AsciiPanel>
    )}

    {page.statusTitle && (
    <AsciiPanel title={page.statusTitle} meta="region not yet mapped">
      <div class="grid items-center gap-8 py-4 sm:grid-cols-[auto_1fr] sm:gap-10">
        <svg viewBox="0 0 120 80" class="unmapped h-20 w-32" aria-hidden="true">
          <path d="M8 40 C 34 40, 34 14, 60 14 S 86 40, 112 40" class="u-path" />
          <path d="M8 40 C 34 40, 34 66, 60 66 S 86 40, 112 40" class="u-path" />
          <circle cx="8" cy="40" r="3.5" class="u-node is-lit" />
          <circle cx="60" cy="14" r="3" class="u-node" />
          <circle cx="60" cy="66" r="3" class="u-node" />
          <circle cx="112" cy="40" r="5" class="u-node is-dark" />
        </svg>
        <div>
          <p class="max-w-[56ch] text-sm leading-relaxed">{page.statusText}</p>
        </div>
      </div>
    </AsciiPanel>
    )}
  </div>
</BaseLayout>

<style>
  .tool-row {
    transition: background-color 180ms ease-out;
  }
  .tool-row:hover,
  .tool-row:focus-visible {
    background-color: color-mix(in srgb, var(--color-phosphor-500) 7%, transparent);
  }
  .tool-row:focus-visible {
    outline-offset: -2px;
  }
  .tool-arrow {
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tool-row:hover .tool-arrow {
    transform: translateX(4px);
  }
  .u-path {
    fill: none;
    stroke: var(--color-phosphor-600);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    opacity: 0.7;
  }
  .u-node {
    fill: var(--color-crt-void);
    stroke: var(--color-phosphor-500);
    stroke-width: 1.2;
  }
  .u-node.is-lit {
    fill: var(--color-phosphor-400);
  }
  .u-node.is-dark {
    stroke-dasharray: 2 2;
  }
  @media (prefers-reduced-motion: no-preference) {
    .u-path {
      animation: u-flow 1.6s linear infinite;
    }
  }
  @keyframes u-flow {
    to {
      stroke-dashoffset: -14;
    }
  }
</style>
